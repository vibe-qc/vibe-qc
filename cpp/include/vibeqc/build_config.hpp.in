// Generated by CMake from build_config.hpp.in — do not edit by hand.
//
// Reports build-time configuration of the C++ core back to the Python
// layer (vibeqc.banner.library_versions()["blas"], CI sanity checks).
// Values populated by configure_file() in cpp/CMakeLists.txt.

#pragma once

#include <string_view>

namespace vibeqc::build_config {

// Raw BLAS_LIBRARIES string from CMake's FindBLAS — e.g.
// "-framework Accelerate" on macOS, "/usr/lib/libblas.so" on Linux
// netlib, "/path/to/libopenblas.so" on Arch + openblas. Empty string
// when no BLAS was linked (VIBEQC_USE_BLAS=OFF or detection failed —
// Eigen runs its generic kernels in that case).
inline constexpr std::string_view kBlasLibraries = "@_VIBEQC_BLAS_BACKEND@";

// True iff lapacke.h was found and EIGEN_USE_LAPACKE was set. When
// false, Eigen's dense solvers (SelfAdjointEigenSolver, LLT, LDLT)
// stay on the generic C++ path even when BLAS is linked — the GEMM
// chain still benefits via EIGEN_USE_BLAS, but dsyev does not.
inline constexpr bool kLapackeEnabled = @_VIBEQC_LAPACKE_FLAG@;

// True iff EIGEN_USE_BLAS was set at compile time. Mirrors a non-empty
// kBlasLibraries; provided separately so a build that opts out via
// -DVIBEQC_USE_BLAS=OFF still has a clear flag to test against.
inline constexpr bool kBlasEnabled = @_VIBEQC_BLAS_FLAG@;

}  // namespace vibeqc::build_config
