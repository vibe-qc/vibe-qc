#!/bin/sh
# Check Git index bytes, including agent instructions and hooks.
# Enable with: git config --local core.hooksPath .githooks
set -e
ROOT=$(git rev-parse --show-toplevel)
python3 "$ROOT/.githooks/check_commit_identity.py"
python3 "$ROOT/.githooks/source_privacy.py" --staged
python3 "$ROOT/.githooks/check_no_em_dashes.py"
python3 "$ROOT/.githooks/check_changelog_fragments.py"
