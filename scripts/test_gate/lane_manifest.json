{
  "schema_version": 1,
  "policy": {
    "summary": "Run smoke plus the lane for the code area touched. For release and patch candidates, use the release-core profile plus --changed-since --impact-mode release. AICCM/CCM/SECCM are experimental manual research lanes, not release, advisory, or automatic impact tests.",
    "runner": "scripts/test_gate/run_full_suite.py --lane <name>",
    "notes": [
      "Lanes select pytest files by glob or explicit node id and keep per-target process isolation.",
      "--changed-since REF infers non-aggregate lanes from trigger_paths and changed test files.",
      "--impact-mode release restricts --changed-since to smoke and explicitly opted-in cheap release-impact lanes; full area lanes remain available with the default dev mode or explicit --lane.",
      "CLI --jobs, --markexpr, --test-timeout, --file-timeout, and --only override lane defaults.",
      "Experimental AICCM/CCM/SECCM lanes are explicit manual research checks only; do not include them in release profiles, advisory profiles, or --changed-since impact gates.",
      "Patch releases (0.15.x) are not blocked by experimental/research-stage features (CCM, MSINDO-CCM, SECCM, aiccm2026dev-a/-b) or by anything documented as planned for a later minor or major release. Track failures in those areas as known-red and ship; escalate only regressions in shipped, non-experimental features."
    ],
    "validation_policy_snapshot": "scripts/test_gate/suite_manifest.json",
    "method_maturity_states": [
      "production",
      "verified",
      "under-review",
      "experimental"
    ],
    "lane_classes": [
      "pre-cut blocking",
      "post-cut evaluation",
      "implementing-chat-only"
    ],
    "scientific_acceptance": {
      "pytest_or_ci_can_accept_method": false,
      "required_evidence": "full-production-shaped-matched-reference-run",
      "required_artifacts": [
        "full input",
        "verbose vibe-qc output",
        "raw reference output",
        "matched-reference analysis"
      ]
    },
    "release_schedule": {
      "pre_cut": "T0 plus T1 from suite_manifest.json; hard T1 wall budget 15 minutes",
      "post_cut": "T2 change-safety inventory plus complete production, verified, and under-review matched-reference calculation inventory on the immutable release",
      "experimental": "T3 implementing-chat-only; artifact is rejected by the blocking verdict"
    },
    "known_stale_target_release": {
      "ref": "#199",
      "reason": "Lanes whose target_release predates the current release line. Tracked so the staleness check can ship before the owning chats retarget; each owner retargets its own lane and removes it from this list in the same change.",
      "lanes": [
        "basis-ecp-integrals",
        "embedding-surfaces-neb",
        "external-reference",
        "full-fast",
        "molecular-correlation",
        "molecular-scf-dft",
        "output-docs",
        "pbc-bipole",
        "pbc-core",
        "pbc-gapw-gpw",
        "pbc-gdf",
        "release-core-cheap",
        "semiempirical",
        "semiempirical-molecular",
        "semiempirical-periodic",
        "slow-nightly",
        "smoke",
        "solvation"
      ]
    }
  },
  "profiles": {
    "release-core": {
      "description": "Blocking release profile for cheap, shipped, non-experimental feature coverage. AICCM/CCM/SECCM are experimental and intentionally absent.",
      "blocking_lanes": [
        "release-core-cheap"
      ],
      "advisory_lanes": [
        "pbc-gapw-gpw",
        "embedding-surfaces-neb",
        "external-reference"
      ]
    }
  },
