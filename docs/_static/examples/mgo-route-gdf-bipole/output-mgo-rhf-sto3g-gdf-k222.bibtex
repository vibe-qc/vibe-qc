@article{sun_berkelbach_gdf_2017,
  author      = {Sun, Qiming and Berkelbach, Timothy C. and McClain, James D. and Chan, Garnet Kin-Lic},
  title       = {Gaussian and plane-wave mixed density fitting for periodic systems},
  journal     = {Journal of Chemical Physics},
  volume      = 147,
  number      = 16,
  pages       = {164119},
  year        = 2017,
  doi         = {10.1063/1.4998644},
  note        = {Mixed Gaussian + plane-wave density fitting for crystals. Defines the analytic periodic AO-pair Fourier transform recursion that PySCF's pbc.df.GDF / ft_aopair implement and that vibe-qc's native builder (cpp/src/aopair_ft.cpp + python/vibeqc/aux_basis.build_lpq_native_fft) mirrors. Cite on every GDF / RSGDF SCF and on the EWALD_3D analytical Hartree J backend.}
}

@article{mcmurchie_davidson_1978,
  author      = {McMurchie, Larry E. and Davidson, Ernest R.},
  title       = {One- and two-electron integrals over Cartesian Gaussian functions},
  journal     = {Journal of Computational Physics},
  volume      = 26,
  number      = 2,
  pages       = {218-231},
  year        = 1978,
  doi         = {10.1016/0021-9991(78)90092-X},
  note        = {Hermite-Gaussian expansion of Cartesian Gaussian products. Underpins the analytic Fourier-transform path that vibe-qc uses to build the GDF / RSGDF 3-centre tensor and the EWALD_3D AO-pair-FT Hartree J on the dense plane-wave mesh — see cpp/src/aopair_ft.cpp and python/vibeqc/_aopair_ft.py.}
}

