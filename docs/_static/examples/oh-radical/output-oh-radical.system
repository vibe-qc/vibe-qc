# vibe-qc system manifest -- written alongside output-<job>.out by run_job(...).
# Captures the runtime environment so generated calculation outputs are
# reproducible and wall-time numbers are interpretable. The [plan]
# section is the declared output contract (written once, at job start);
# the [outputs] section is the running status (rewritten as each file
# lands). External QC programs are validation references only: run
# them out-of-process and parse their outputs.

[vibeqc]
version        = "0.15.23.dev0"
codename       = "Neese's Cheetah"
git_sha        = "dc22a26"
git_branch     = "main"
is_release     = false

[host]
hostname       = "<redacted>"
os             = "Darwin"
os_release     = "25.5.0"
os_pretty      = "macOS 26.5.2"
arch           = "arm64"

[cpu]
model          = "Apple M5 Max"
physical_cores = 18
logical_cores  = 18
omp_threads_used = 18

[memory]
total_gb       = 128.0
available_gb   = 88.13

[python]
version        = "3.14.6"
implementation = "CPython"
executable     = "~/gitlab/vibeqc-documentation/.venv/bin/python"

[libraries]
libint         = "2.13.1"
libxc          = "7.0.0"
spglib         = "2.7.0"
libecpint      = "1.0.7 (vendored, MAX_L=5)"
fftw3          = "3.3.9"

[validation]
external_programs_policy = "External QC programs are validation references only."
execution_boundary = "Run external programs out-of-process and parse their outputs; do not import them as vibe-qc backends."
native_backend_policy = "vibe-qc runtime methods execute vibe-qc-owned native or Python code."

[run]
timestamp_iso  = "2026-07-05T17:17:24+02:00"
wall_seconds   = 0.052752708026673645
basename       = "output-oh-radical"
pid            = 17966

[plan]
stem             = "<vibe-qc-checkout>/examples/molecular/output-oh-radical"
job_kind         = "molecular_scf"
method           = "UHF"
basis            = "6-31g*"
functional       = ""
options_digest   = "2e2863f78ae9"

[[plan.files]]
role          = "log"
path          = "<vibe-qc-checkout>/examples/molecular/output-oh-radical.out"
format        = "text"
always        = true
description   = "Human-readable SCF log (banner, iter table, orbital block, references)."

[[plan.files]]
role          = "manifest"
path          = "<vibe-qc-checkout>/examples/molecular/output-oh-radical.system"
format        = "toml"
always        = true
description   = "Runtime manifest -- hardware, libs, plan, outputs status."

[[plan.files]]
role          = "orbitals"
path          = "<vibe-qc-checkout>/examples/molecular/output-oh-radical.molden"
format        = "molden"
always        = true
description   = "Molecular orbitals -- coefficients, energies, occupations."

[[plan.files]]
role          = "geometry"
path          = "<vibe-qc-checkout>/examples/molecular/output-oh-radical.xyz"
format        = "xyz"
always        = true
description   = "Final geometry in Angstrom."

[[plan.files]]
role          = "citations"
path          = "<vibe-qc-checkout>/examples/molecular/output-oh-radical.bibtex"
format        = "bibtex"
always        = true
description   = "BibTeX entries for every method, basis, and library cited."

[[plan.files]]
role          = "citations"
path          = "<vibe-qc-checkout>/examples/molecular/output-oh-radical.references"
format        = "text"
always        = true
description   = "Plain-text reference list (Chicago-ish formatting)."

[[plan.files]]
role          = "population"
path          = "<vibe-qc-checkout>/examples/molecular/output-oh-radical.population.txt"
format        = "text"
always        = true
description   = "Mulliken / Löwdin charges + Mayer bond orders + dipole -- tab-separated."

[[plan.files]]
role          = "population"
path          = "<vibe-qc-checkout>/examples/molecular/output-oh-radical.population.json"
format        = "json"
always        = true
description   = "Population / properties dump -- JSON form for dashboards / regression scripts."

[[plan.files]]
role          = "crash"
path          = "<vibe-qc-checkout>/examples/molecular/output-oh-radical.dump"
format        = "toml"
always        = false
description   = "Post-mortem snapshot -- only written on SCF failure or max-iter without convergence."

[[plan.files]]
role          = "qvf"
path          = "<vibe-qc-checkout>/examples/molecular/output-oh-radical.qvf"
format        = "qvf"
always        = true
description   = "QVF visualisation archive -- zip with manifest.json + typed binary/text payloads."

[outputs]
status           = "complete"
finished_at_iso  = "2026-07-05T17:17:24+02:00"

