---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title = 'vibe-qc — Quantum chemistry for molecules and solids',
  description = 'Calculate with vibe-qc, explore results with vibe-view, and schedule work with vibe-queue. Three independently installed products for molecular and periodic quantum chemistry, connected through the QVF file format.',
  socialImage = 'vibe-qc-social.png',
  socialImageAlt = 'vibe-qc, vibe-view and vq: Calculate. Explore. Keep work moving.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;

// Staging (served under /preview/) must not be indexed — BASE_URL is
// '/preview/' there and '/' in production. Assets keyed off it too.
const base = import.meta.env.BASE_URL;
const isPreview = base !== '/';

// PNG previews are exported from the outlined SVG masters in public/logo/.
const ogImage = new URL(`${base}logo/${socialImage}`, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}logo/vibe-qc-favicon.png`} type="image/png" sizes="32x32" />
    <link rel="icon" href={`${base}logo/vibe-qc-favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}logo/vibe-qc-apple-touch-icon.png`} sizes="180x180" />
    <meta name="theme-color" content="#0F766E" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#08120F" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph / Twitter use a family card or the current product card. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
  </head>
  <body>
    <slot />
  </body>
</html>
