---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { products } from '../data/products.mjs';
import { repositories } from '../data/repositories.mjs';
import { distributionMatrix, publicDownloadUrl, publicOciImage } from '../data/distributions.mjs';
const base = import.meta.env.BASE_URL;
const artifacts = distributionMatrix.desktop.map(a => ({ ...a, url: publicDownloadUrl(a) })).filter(a => a.url);
const images = distributionMatrix.oci.images.map(i => ({ ...i, published: publicOciImage(i) })).filter(i => i.published);
const channels = [
  ['Linux', 'x86-64', 'Supporter downloads', 'Portable archives for the engine and queue; AppImage for the viewer and sketcher.'],
  ['macOS', 'Apple Silicon', 'Paid Mac App Store', 'Complete application packages with their required runtimes. Current local desktop previews do not establish Store availability.'],
  ['Windows', 'x86-64', 'Paid Microsoft Store', 'Native application packages with their required runtimes. Platform qualification and Store publication remain separate steps.'],
];
---
<Base title="Downloads and installation — vibe-qc" description="Current source installation routes, desktop implementation status and planned binary channels for the vibe scientific toolset. MPL-2.0 applications and Apache-2.0 QVF.">
  <Nav />
  <main id="main-content" class="wrap downloads">
    <header class="page-heading">
      <span class="eyebrow">official distribution matrix</span>
      <h1>Choose a tool.<br />Check its availability.</h1>
      <p>Each project has its own source, releases and installation route. A working desktop build or a source tag does not mean a downloadable installer has been published.</p>
    </header>
    <section class="download-section" aria-labelledby="install-now">
      <span class="eyebrow">available installation routes</span>
      <h2 id="install-now">Start with the installation guide.</h2>
      <div class="grid install-grid">
        {products.map(product => <article class="card">
          <h3>{product.name}</h3>
          <p>{product.repository ? 'Public source snapshots. Follow the guide for dependencies and a dedicated environment; choose a published source tag when pinning a version.' : 'Testing version with browser and desktop workflows. Access is arranged with the maintainer; no public source or installer link is listed here.'}</p>
          <p class="product-license"><a href={product.licenseGuide}>{product.license} license &amp; notices ↗</a></p>
          <div class="route-links">
            <a href={product.installGuide}>Installation guide ↗</a>
            <a href={`${base}products/${product.id}/`}>Product details ↗</a>
            {product.repository ? <><a href={product.repository}>Source repository ↗</a><a href={`${product.repository}/tags`}>Source tags ↗</a><a href={`${product.repository}/releases`}>Published releases ↗</a></> : <a href={`${base}contact?topic=access&product=vibe-sketch`}>Request vibe-sketch access ↗</a>}
          </div>
        </article>)}
      </div>
    </section>
    <section class="download-section" aria-labelledby="desktop-status">
      <span class="eyebrow">implemented desktop workflows</span>
      <h2 id="desktop-status">Browser and desktop, with version-specific runtimes.</h2>
      <div class="grid install-grid">
        <article class="card"><h3>vibe-view</h3><p>Browser, Electron desktop, terminal and headless interfaces are implemented. Current Apple Silicon package tooling bundles Python, PyVista, VTK, Trame and RDKit for macOS 14 or newer. AppImage and NSIS shell builds still need an external Python environment.</p><a href="/vibe-view/docs/desktop.html">Viewer desktop guide ↗</a></article>
        <article class="card"><h3>vibe-sketch</h3><p>Browser and Electron desktop workflows include Open, Save, recent files, import and export. Current Apple Silicon tooling bundles Python, RDKit, QVF and the editor for macOS 14 or newer; this runtime is newer than the 0.1.3 release artifacts.</p><a href="/vibe-sketch/docs/desktop.html">Sketcher desktop guide ↗</a></article>
      </div>
      <p class="availability-note">Local ad-hoc-signed builds do not establish trusted signing, notarization or Store acceptance. The former vibe-view 2.9.0 candidates are historical records, not current download options.</p>
    </section>
    <section class="download-section" aria-labelledby="binary-channels">
      <span class="eyebrow">planned binary channels</span>
      <h2 id="binary-channels">Packaging plans, with availability stated separately.</h2>
      <p>The four application projects document these initial channels. They are planned channels, not available download or purchase links.</p>
      <div class="channel-table"><table><thead><tr><th scope="col">Platform</th><th scope="col">Initial architecture</th><th scope="col">Planned channel</th><th scope="col">Package scope</th></tr></thead><tbody>{channels.map(row => <tr>{row.map((cell,i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>
      <p>Official Linux binary downloads are planned for supporter members. Downloaded versions continue working after membership expires, without runtime activation. Store purchases are separate from website membership. Building published source does not require a membership; required corresponding source and notices remain accessible without an active membership.</p>
      <p>vibe-sketch uses MPL-2.0 too, while public source publication and access remain separate. Bundled third-party dependencies retain their own licenses.</p>
    </section>
    <section class="download-section" aria-labelledby="published-packages">
      <span class="eyebrow">verified package links</span>
      <h2 id="published-packages">Downloads listed on this site.</h2>
      {artifacts.length === 0 && images.length === 0 ? <p>No qualified binary package or suite image is listed here. Use the project installation guides above; do not infer a package URL from its version or filename.</p> : <div class="grid">
        {artifacts.map(artifact => <article class="card"><h3>{artifact.product} · {artifact.platform}</h3><p>{artifact.architecture}</p><p><code>{artifact.sha256}</code></p><a href={artifact.url}>Download {artifact.platform} ↗</a></article>)}
        {images.map(image => <article class="card"><h3>{image.label}</h3><p>{image.ociPlatform}</p><code>{image.published.pinnedReference}</code></article>)}
      </div>}
      <p>Release listings and source mirrors may lag canonical development. The reviewed public GitHub release listings contained no release assets on 2026-10-19. Legacy container plans are not a published suite or a combined release of the four applications.</p>
    </section>
    <section class="download-section" aria-labelledby="format-and-source">
      <span class="eyebrow">independent source projects</span>
      <h2 id="format-and-source">QVF and the source directory.</h2>
      <p>QVF remains Apache-2.0. Its specification, schemas and reference toolkit are independently versioned; the applications use MPL-2.0. A QVF archive retains the licensing and provenance of its own contents.</p>
      <div class="source-list">{repositories.map(repository => <article><h3>{repository.name}</h3><p>{repository.role}</p><a href={repository.github || `${base}products/vibe-sketch/#install`}>{repository.github ? 'Source repository ↗' : 'Access & setup ↗'}</a></article>)}</div>
      <p class="reviewed">Feature and availability review: {distributionMatrix.lastReviewed}. Check the installation guide for the version you intend to run.</p>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .downloads { padding-bottom: 80px; }
  .download-section { padding: 40px 0; border-bottom: 1px solid var(--line); }
  h2 { font-size: clamp(25px, 3vw, 36px); line-height: 1.2; margin: 14px 0 24px; }
  h3 { margin: 0 0 14px; font-size: 22px; }
  p { color: var(--slate); line-height: 1.65; }
  .install-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); margin-block: 28px; }
  .route-links { display: flex; flex-wrap: wrap; gap: 12px 20px; font-size: 14px; }
  a { color: var(--phase-pos); text-underline-offset: 4px; }
  a:hover { text-decoration: underline; }
  .product-license { font-size: 13px; }
  .availability-note { padding: 18px 22px; background: var(--surface-2); border-left: 2px solid var(--phase-pos); }
  .channel-table { overflow-x: auto; margin-block: 28px; }
  table { width: 100%; border-collapse: collapse; text-align: left; }
  th, td { padding: 15px 18px; border-bottom: 1px solid var(--line); vertical-align: top; font-size: 14px; }
  thead { background: var(--surface-2); }
  td { color: var(--slate); }
  .source-list { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); gap: 28px; margin: 30px 0; }
  .reviewed { font-size: 13px; }
  code { overflow-wrap: anywhere; }
  @media(max-width:650px) { .install-grid, .source-list { grid-template-columns:1fr; } th, td { padding:12px; min-width:120px; } }
</style>
