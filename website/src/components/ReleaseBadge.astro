---
import releases from '../data/published-releases.json';
const {product} = Astro.props;
const release = releases[product];
const base = import.meta.env.BASE_URL;
const href = release.url.startsWith('/') ? `${base}${release.url.slice(1)}` : release.url;
---
<a class="release-badge" href={href}><span>{release.channel}</span><strong>v{release.version}</strong><span aria-hidden="true">↗</span></a>
<style>
.release-badge{display:inline-flex;align-items:center;gap:12px;padding:8px 12px;border:1px solid var(--line);border-radius:5px;color:var(--slate);font-size:12px;text-decoration:none;margin:8px 0 16px;}
.release-badge strong{color:var(--phase-pos);font-size:16px;font-variant-numeric:tabular-nums;} .release-badge:hover{border-color:var(--phase-pos);}
</style>
