---
const base = import.meta.env.BASE_URL;
---
<figure class="workflow-figure">
  <div class="figure-heading"><span>STRUCTURE → RESULT</span><span>WORKFLOW / 01</span></div>
  <svg viewBox="0 0 520 310" role="img" aria-labelledby="workflow-title workflow-desc">
    <title id="workflow-title">From molecular structure to electronic structure</title>
    <desc id="workflow-desc">An illustrative ring structure and orbital contours, connected by an arrow. This schematic is not a calculated result.</desc>
    <defs><pattern id="graph-paper" width="26" height="26" patternUnits="userSpaceOnUse"><path d="M26 0H0V26" fill="none" stroke="currentColor" stroke-opacity=".07" /></pattern></defs>
    <rect width="520" height="310" fill="url(#graph-paper)"/>
    <g fill="none" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round">
      <path d="M76 118L120 92L164 118V170L120 196L76 170Z M87 125L120 106 M152 126V162 M120 182L88 163 M164 118L197 99"/>
    </g>
    <text x="197" y="101" fill="var(--phase-pos)" font-size="18" font-family="var(--mono)">OH</text>
    <path d="M235 145H286L278 137M286 145L278 153" fill="none" stroke="var(--slate)" stroke-width="1.5"/>
    <g transform="translate(385 145) rotate(-32)" fill="none" stroke-width="1.3">
      <g stroke="var(--phase-pos)"><ellipse cx="-31" rx="59" ry="37" fill="var(--phase-pos)" fill-opacity=".1"/><ellipse cx="-31" rx="59" ry="25"/><ellipse cx="-31" rx="59" ry="12"/><ellipse cx="-31" rx="25" ry="37"/></g>
      <g stroke="var(--phase-neg)"><ellipse cx="49" rx="59" ry="37" fill="var(--phase-neg)" fill-opacity=".08"/><ellipse cx="49" rx="59" ry="25"/><ellipse cx="49" rx="59" ry="12"/><ellipse cx="49" rx="25" ry="37"/></g>
      <circle cx="8" r="6" fill="var(--ink)" stroke="var(--surface)" stroke-width="2"/>
    </g>
    <g fill="var(--slate)" font-size="10" font-family="var(--mono)" letter-spacing="1.2"><text x="74" y="249">MOLECULAR GRAPH</text><text x="323" y="249">ELECTRONIC STRUCTURE</text></g>
  </svg>
  <div class="figure-steps">
    {[['01','Sketch','vibe-sketch'],['02','Submit','vibe-queue'],['03','Calculate','vibe-qc'],['04','Analyze','vibe-view']].map(([n,label,id]) => <a href={`${base}products/${id}/`}><span>{n}</span>{label}<b aria-hidden="true">↗</b></a>)}
  </div>
  <figcaption>Illustrative schematic · tools install independently</figcaption>
</figure>
