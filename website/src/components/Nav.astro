---
import { products } from '../data/products.mjs';
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const sections = [['Documentation', 'documentation/'], ['Workflows', 'workflows/'], ['Methods', 'methods/'], ['Downloads', 'download/']];
---
<header class="nav">
  <div class="wrap nav-inner">
    <a class="brand-mark" href={base} aria-label="vibe-qc home">
      <img class="wm-light" src={`${base}logo/vibe-qc-wordmark-light.svg`} alt="vibe-qc" width="217" height="48" />
      <img class="wm-dark" src={`${base}logo/vibe-qc-wordmark-dark.svg`} alt="vibe-qc" width="217" height="48" />
      <span class="site-label">TECHNICAL</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-links" aria-label="Open menu">☰</button>
    <nav class="links" id="site-links" aria-label="Main navigation">
      <details class="tool-menu">
        <summary>Tools <span aria-hidden="true">⌄</span></summary>
        <div class="tool-menu-panel">
          {products.map(product => <div class="nav-product">
            <a href={`${base}products/${product.id}/`}><strong>{product.name}</strong><small>{product.action}{product.status ? ` · ${product.status}` : ''}</small></a>
            <a class="nav-docs" href={product.docs || `${base}products/${product.id}/#install`}>{product.docs ? `${product.id === 'vibe-queue' ? 'vq' : product.name} docs` : 'Access & setup'} ↗</a>
          </div>)}
        </div>
      </details>
      {sections.map(([name, href]) => <a href={`${base}${href}`} aria-current={path === `${base}${href}` ? 'page' : undefined}>{name}</a>)}
      <a class="nav-cta" href={`${base}get-started`}>Get started <span aria-hidden="true">↗</span></a>
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector('header.nav');
  const toggle = header?.querySelector('.nav-toggle');
  const details = header?.querySelector('details');
  const setOpen = (open: boolean) => {
    header?.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  };
  toggle?.addEventListener('click', () => setOpen(!header?.classList.contains('menu-open')));
  header?.querySelectorAll('.links a').forEach(a => a.addEventListener('click', () => { setOpen(false); if (details) details.open = false; }));
  document.addEventListener('click', e => { if (details && !details.contains(e.target as Node)) details.open = false; });
  document.addEventListener('keydown', e => {
    if (e.key !== 'Escape') return;
    if (details?.open) { details.open = false; details.querySelector('summary')?.focus(); }
    else if (header?.classList.contains('menu-open')) { setOpen(false); (toggle as HTMLElement)?.focus(); }
  });
</script>
