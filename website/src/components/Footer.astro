---
import { products } from '../data/products.mjs';
const base = import.meta.env.BASE_URL;
---
<footer>
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="brand-mark" href={base} aria-label="vibe-qc home">
          <img class="wm-light" src={`${base}logo/vibe-qc-wordmark-light.svg`} alt="vibe-qc" width="217" height="48" />
          <img class="wm-dark" src={`${base}logo/vibe-qc-wordmark-dark.svg`} alt="vibe-qc" width="217" height="48" />
        </a>
        <p>Scientific software for structures, calculations and results. The technical home of the vibe toolset.</p>
        <a class="text-link" href="https://vibyverse.com">Discover the wider Vibyverse ↗</a>
      </div>
      <div><h5>Tools</h5><ul>{products.map(p => <li><a href={`${base}products/${p.id}/`}>{p.name}</a></li>)}<li><a href="https://github.com/vibe-qc/qvf">QVF format ↗</a></li></ul></div>
      <div><h5>Learn & build</h5><ul>
        <li><a href={`${base}documentation/`}>Documentation</a></li>
        <li><a href={`${base}workflows/`}>Workflows</a></li>
        <li><a href={`${base}methods/`}>Methods & status</a></li>
        <li><a href="/docs/validation.html">Validation</a></li>
        <li><a href="/docs/citing.html">Citations</a></li>
        <li><a href="/docs/changelog.html">Core changelog</a></li>
      </ul></div>
      <div><h5>Project</h5><ul>
        <li><a href="https://github.com/vibe-qc/vibe-qc">Core source ↗</a></li>
        <li><a href={`${base}download`}>Downloads</a></li>
        <li><a href={`${base}sponsor`}>Support the work</a></li>
        <li><a href={`${base}contact`}>Contact & access</a></li>
        <li><a href="/docs/license.html">Core license</a></li>
        <li><a href="/docs/roadmap.html">Roadmap</a></li>
      </ul></div>
    </div>
    <div class="foot-bottom"><span>© {new Date().getFullYear()} vibe-qc · Michael F. Peintinger</span><span class="lic">Licenses are product-specific · vibe-sketch is proprietary</span></div>
  </div>
</footer>
